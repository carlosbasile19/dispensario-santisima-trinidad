NEXT_PUBLIC_SUPABASE_URL=https://xnbinvflvurdpvbctxfh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_R8n-MB43zqCFObSoc_9Dow_kUHkFaZS

# Fallback origin for auth email links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets go below this line. Never prefix them with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# Bearer token Vercel Cron sends to /api/cron/bcv and /api/cron/whatsapp (any long random string).
# CRON_SECRET=

# WhatsApp through Zernio (README "WhatsApp"). `node scripts/zernio-setup.mjs`
# creates the three in your Zernio account and prints them.
# ZERNIO_API_KEY=          # key limited to the clinic's profile
# ZERNIO_PROFILE_ID=       # the clinic's Zernio profile
# ZERNIO_WEBHOOK_SECRET=   # secret of the webhook pointing at /api/whatsapp/webhook

# Lab dictation (README "Laboratorio" › Dictation): Claude sorts dictated results.
# ANTHROPIC_API_KEY=
# LAB_DICTATION_MODEL=claude-opus-5-5   # optional
# LAB_DICTATION_EFFORT=medium           # optional: low, medium, high
